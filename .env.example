# MongoDB Demo Hub — placeholders only. Never commit real secrets.
# All variables are server-only; none are prefixed NEXT_PUBLIC_.

# --- Catalog database (MongoDB Atlas in production) ---
# Without MONGODB_URI the Hub runs in read-only seed catalog mode.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=demo_hub

# --- Corporate SSO (OIDC). Required in production; access is denied when unset. ---
OIDC_ISSUER=https://<your-idp>/oauth2/<tenant>
OIDC_CLIENT_ID=<client-id>
OIDC_CLIENT_SECRET=<client-secret>
OIDC_PROVIDER_NAME=MongoDB SSO
ALLOWED_EMAIL_DOMAINS=mongodb.com
# Generate with: openssl rand -base64 32
AUTH_SECRET=<random-32-byte-secret>
# Comma-separated emails bootstrapped as admin on first sign-in
INITIAL_ADMIN_EMAILS=

# --- Local development only. Ignored when NODE_ENV=production or on Vercel production/preview. ---
DEV_AUTH_MODE=false
# Demonstration access: while OIDC is NOT configured, demo viewer/contributor/admin
# accounts are available in every environment. Turns off automatically once OIDC is set.
# Set to false to keep the Hub locked until SSO is configured.
DEMO_ACCESS=true
DEV_AUTH_ALLOW_PREVIEW=false

# --- GitHub (read-only). Prefer a GitHub App with Contents:read + Metadata:read. ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# Alternative: fine-grained read-only token
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Bearer token for POST /api/sync/scheduled
CRON_SECRET=

# --- Optional object storage for screenshot uploads (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=
