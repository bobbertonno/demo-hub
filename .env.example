# MongoDB Demo Hub — placeholders only. Never commit real secrets.
# All variables are server-only; none are prefixed NEXT_PUBLIC_.
# The Hub runs in local mode: there are no user accounts and every visitor has full access.
# Run it only on a trusted machine or network.

# --- Catalog database ---
# Without MONGODB_URI the Hub runs in read-only seed catalog mode.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=demo_hub

# --- Screenshot uploads (stored on local disk) ---
ASSET_STORAGE_DIR=./.data/assets

# --- GitHub (read-only). Prefer a GitHub App with Contents:read + Metadata:read. ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# Alternative: fine-grained read-only token
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Bearer token for POST /api/sync/scheduled
CRON_SECRET=
